[Unit]
Description=HomeLab media with verified external filesystem
After=docker.service @MEDIA_MOUNT@
Requires=docker.service
BindsTo=@MEDIA_MOUNT@
RequiresMountsFor=@MEDIA_ROOT@
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO_ROOT@
ExecStart=/usr/bin/python3 @REPO_ROOT@/scripts/lib/homelab.py deploy --stack media
ExecStop=/usr/bin/python3 @REPO_ROOT@/scripts/lib/homelab.py stop --stack media
TimeoutStartSec=10m
TimeoutStopSec=2m
[Install]
WantedBy=multi-user.target

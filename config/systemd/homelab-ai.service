[Unit]
Description=HomeLab Opt-in Ollama and Open WebUI with verified data filesystem
After=docker.service @DATA_MOUNT@ homelab-media.service homelab-storage.service homelab-management.service
Requires=docker.service
PartOf=docker.service
BindsTo=@DATA_MOUNT@
RequiresMountsFor=@DATA_ROOT@
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO_ROOT@
ExecStart=/usr/bin/python3 @REPO_ROOT@/scripts/lib/homelab.py deploy --stack ai --wait-lock
ExecStop=/usr/bin/python3 @REPO_ROOT@/scripts/lib/homelab.py stop --stack ai --wait-lock
TimeoutStartSec=@STACK_UNIT_TIMEOUT@
TimeoutStopSec=2m
[Install]
WantedBy=multi-user.target docker.service

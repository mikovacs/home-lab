# Manual fallback: copy to .env and edit. The wizard writes external host.env. Never source this file.
TZ=Europe/Budapest
# Interactive installer stores host-only configuration here, outside the Git checkout.
HOMELAB_CONFIG_DIR=/etc/homelab
DOMAIN=example.com
LAN_IP=192.0.2.10
LAN_INTERFACE=SET_ME
LAN_CIDR=192.0.2.0/24
ADMIN_CIDRS=192.0.2.0/24,100.64.0.0/10
# Inspect retained media ownership before choosing these IDs. Existing numeric mappings are reused.
MEDIA_USER=homelab-media
MEDIA_GROUP=homelab-media
PUID=1000
PGID=1000
REPO_ROOT=/srv/homelab/repository
APPDATA_ROOT=/srv/homelab/appdata
SECRETS_ROOT=/srv/homelab/secrets
RUNTIME_ROOT=/srv/homelab/runtime
DATA_ROOT=/mnt/homelab-data
DATA_UUID=SET_ME
MEDIA_ROOT=/mnt/plex-media
MEDIA_UUID=SET_ME
PROXY_NETWORK=homelab-proxy
AI_NETWORK=homelab-ai
TUNNEL_NETWORK=homelab-tunnel
ACME_EMAIL=admin@example.com
ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TUNNEL_ID=SET_ME
# Only these named services may be exported; empty means no remote apps.
REMOTE_APPS=
# Confirm local accounts, MFA, access policies and webhook authentication first.
REMOTE_READY=no
IDENTITY_READY=no
TERMINAL_BRIDGE=hl-terminal
ADMIN_SSH_USER=SET_ME
ADMIN_SSH_HOST=SET_ME
DISK_WARN=80
DISK_CRITICAL=90
MIN_MEDIA_FREE_GIB=10
# Allow first-run migrations on slower hardware; deployment recreates containers/bind mounts.
STACK_START_TIMEOUT=600
# Docker must wait for the configured LAN address before restoring published ports.
NETWORK_START_TIMEOUT=180
# Persistent optional Compose services; allowed: bazarr,admin. Empty keeps both opt-in.
COMPOSE_PROFILES=
JELLYFIN_MEMORY=2g
AI_MEMORY=4g
AI_CPUS=2
RESTIC_REPOSITORY=/mnt/homelab-data/backups/restic
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
